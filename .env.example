# MariaDB / MySQL. Prisma CLI uses DATABASE_URL.
DATABASE_URL="mysql://evolution:evolution_password@127.0.0.1:3306/evolution"

# The runtime adapter prefers these explicit values and falls back to DATABASE_URL.
DATABASE_HOST="127.0.0.1"
DATABASE_PORT="3306"
DATABASE_USER="evolution"
DATABASE_PASSWORD="evolution_password"
DATABASE_DB="evolution"

# NextAuth v5. Generate a real value with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
